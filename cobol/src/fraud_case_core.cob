           IF WS-P1 = SPACES
               MOVE "ERROR|INVALID_INPUT" TO WS-RESULT
               EXIT PARAGRAPH
           END-IF
           MOVE "SUCCESS|FRC_CREATE|OK" TO WS-RESULT
           EXIT PARAGRAPH.

       ACTION-FRC_LIST.
           MOVE "SUCCESS|FRC_LIST|OK" TO WS-RESULT
           EXIT PARAGRAPH.

       ACTION-FRC_GET.
           MOVE FUNCTION NUMVAL(WS-P1) TO WS-NUM-PRINCIPAL
           MOVE SPACES TO WS-RESULT
           STRING "SUCCESS|FRC_GET|" DELIMITED BY SIZE
                  WS-NUM-PRINCIPAL DELIMITED BY SIZE
                  INTO WS-RESULT
           END-STRING
           EXIT PARAGRAPH.

       ACTION-FRC_CALC.
           MOVE FUNCTION NUMVAL(WS-P1) TO WS-NUM-PRINCIPAL
           MOVE FUNCTION NUMVAL(WS-P2) TO WS-NUM-RATE
           IF WS-NUM-PRINCIPAL <= 0
               MOVE "ERROR|INVALID_INPUT" TO WS-RESULT
               EXIT PARAGRAPH
           END-IF
           COMPUTE WS-NUM-AMOUNT = WS-NUM-PRINCIPAL * WS-NUM-RATE / 100
           MOVE SPACES TO WS-RESULT
           STRING "SUCCESS|FRC_CALC|" DELIMITED BY SIZE
                  WS-NUM-AMOUNT DELIMITED BY SIZE
                  INTO WS-RESULT
           END-STRING
           EXIT PARAGRAPH.

