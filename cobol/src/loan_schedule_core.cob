                   PERFORM ACTION-LSC_SYNCHRONIZER
               WHEN LS-CMD-ACTION(1:14) = "LSC_REPLICATOR"
                   PERFORM ACTION-LSC_REPLICATOR
               WHEN LS-CMD-ACTION(1:11) = "LSC_MONITOR"
                   PERFORM ACTION-LSC_MONITOR
               WHEN LS-CMD-ACTION(1:10) = "LSC_LOGGER"
                   PERFORM ACTION-LSC_LOGGER
               WHEN OTHER
                   MOVE "ERROR|INVALID_ACTION" TO WS-RESULT
           END-EVALUATE
           MOVE WS-RESULT TO LS-OUTPUT-BUFFER
           GOBACK.

