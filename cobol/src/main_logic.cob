       IDENTIFICATION DIVISION.
       PROGRAM-ID. main_logic.

        ENVIRONMENT DIVISION.
        CONFIGURATION SECTION.
        SPECIAL-NAMES.
            DECIMAL-POINT IS COMMA.

        INPUT-OUTPUT SECTION.
        FILE-CONTROL.
            SELECT INPUT-FILE ASSIGN TO "input.txt"
                ORGANIZATION IS LINE SEQUENTIAL.
            SELECT OUTPUT-FILE ASSIGN TO "output.txt"
                ORGANIZATION IS LINE SEQUENTIAL.

        DATA DIVISION.
        FILE SECTION.
        FD  INPUT-FILE.
        01  INPUT-RECORD     PIC X(500).
        FD  OUTPUT-FILE.
        01  OUTPUT-RECORD     PIC X(500).

        WORKING-STORAGE SECTION.
        01  INPUT-BUFFER       PIC X(500) VALUE SPACES.
        01  CMD-ACTION        PIC X(20) VALUE SPACES.
        01  CMD-PARAM1        PIC X(100) VALUE SPACES.
        01  CMD-PARAM2        PIC X(100) VALUE SPACES.
        01  CMD-PARAM3        PIC X(100) VALUE SPACES.
        01  CMD-PARAM4        PIC X(100) VALUE SPACES.
        01  CMD-PARAM5        PIC X(100) VALUE SPACES.
        01  CMD-PARAM6        PIC X(100) VALUE SPACES.
        01  WS-OUTPUT-MSG     PIC X(16384) VALUE SPACES.
        01  WS-OUT-LEN        PIC 9(5) VALUE 0.
        01  WS-OUT-POS        PIC 9(5) VALUE 1.
        01  WS-OUT-I          PIC 9(5) VALUE 0.
        01  WS-ARGS           PIC X(200) VALUE SPACES.
        01  WS-SERVE-DONE     PIC X VALUE 'N'.
        01  WS-EOF            PIC X VALUE 'N'.
        
        PROCEDURE DIVISION.
        
        MAIN-LOGIC.
            ACCEPT WS-ARGS FROM COMMAND-LINE
            IF WS-ARGS(1:7) = "--serve"
                PERFORM SERVE-MODE
            ELSE
                PERFORM FILE-MODE
            END-IF.
            MOVE 0 TO RETURN-CODE.
            STOP RUN.

        FILE-MODE.
            *> Default: read one request line from input.txt, write output.txt.
            OPEN INPUT INPUT-FILE
            OPEN OUTPUT OUTPUT-FILE
            MOVE 'N' TO WS-EOF
            MOVE SPACES TO INPUT-BUFFER
            READ INPUT-FILE INTO INPUT-BUFFER
                AT END MOVE 'Y' TO WS-EOF
            END-READ
            IF WS-EOF NOT = 'Y'
                PERFORM PARSE-INPUT
                PERFORM DISPATCH-ACTION
                PERFORM WRITE-OUTPUT
            END-IF.
            CLOSE INPUT-FILE
            CLOSE OUTPUT-FILE.
            EXIT PARAGRAPH.

        SERVE-MODE.
            *> Long-running mode: one request line per stdin, one result line
            *> per stdout, until QUIT or EOF (used by the worker pool).
            PERFORM UNTIL WS-SERVE-DONE = 'Y'
                MOVE SPACES TO INPUT-BUFFER
                ACCEPT INPUT-BUFFER
                IF INPUT-BUFFER = SPACES
                    MOVE 'Y' TO WS-SERVE-DONE
                ELSE IF INPUT-BUFFER(1:4) = "QUIT"
                    MOVE 'Y' TO WS-SERVE-DONE
                ELSE
                    PERFORM PARSE-INPUT
                    PERFORM DISPATCH-ACTION
                    DISPLAY FUNCTION TRIM(WS-OUTPUT-MSG)
                END-IF
            END-PERFORM.
            EXIT PARAGRAPH.

        PARSE-INPUT.
            MOVE SPACES TO CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6
            UNSTRING INPUT-BUFFER DELIMITED BY "|" 
                INTO CMD-ACTION, CMD-PARAM1, CMD-PARAM2, CMD-PARAM3, CMD-PARAM4, CMD-PARAM5, CMD-PARAM6
            END-UNSTRING.
            EXIT PARAGRAPH.

        DISPATCH-ACTION.
            *> Routing shared by both modes: set WS-OUTPUT-MSG for the action.
            MOVE SPACES TO WS-OUTPUT-MSG
            IF CMD-ACTION = SPACES
                MOVE "ERROR|MISSING_ACTION" TO WS-OUTPUT-MSG
                EXIT PARAGRAPH
            END-IF.
            IF CMD-ACTION(1:13) = "CHECK_BALANCE"
                CALL "wallet_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:16) = "REVERSE_TRANSFER"
                CALL "wallet_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:9) = "TX_STATUS"
                CALL "wallet_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:8) = "TRANSFER"
                CALL "wallet_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:8) = "GET_USER"
                CALL "user_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:10) = "LIST_USERS"
                CALL "user_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:13) = "GET_DASHBOARD"
                CALL "user_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:16) = "REQ_EMAIL_CHANGE"
                CALL "user_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:20) = "CONFIRM_EMAIL_CHANGE"
                CALL "user_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:14) = "UPDATE_PROFILE"
                CALL "user_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:18) = "DEACTIVATE_ACCOUNT"
                CALL "user_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:15) = "SET_USER_STATUS"
                CALL "user_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:11) = "UNLOCK_USER"
                CALL "user_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:15) = "ADMIN_RESET_MFA"
                CALL "user_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:10) = "PLACE_HOLD"
                CALL "wallet_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:12) = "RELEASE_HOLD"
                CALL "wallet_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:9) = "RECONCILE"
                CALL "wallet_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:18) = "RUN_RECONCILIATION"
                CALL "wallet_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:10) = "AUTH_LOGIN"
                CALL "auth_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:14) = "REQUEST_SIGNUP"
                CALL "auth_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:12) = "VERIFY_EMAIL"
                CALL "auth_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:13) = "VERIFY_REAUTH"
                CALL "auth_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:15) = "FORGOT_PASSWORD"
                CALL "auth_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:14) = "RESET_PASSWORD"
                CALL "auth_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:15) = "CHANGE_PASSWORD"
                CALL "auth_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:19) = "RESEND_VERIFICATION"
                CALL "auth_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:16) = "MFA_ENROLL_BEGIN"
                CALL "auth_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:18) = "MFA_ENROLL_CONFIRM"
                CALL "auth_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:11) = "MFA_DISABLE"
                CALL "auth_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:10) = "CHECK_ROLE"
                CALL "auth_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:11) = "CHANGE_ROLE"
                CALL "auth_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:13) = "STORE_SESSION"
                CALL "auth_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:14) = "REVOKE_SESSION"
                CALL "auth_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:15) = "CONSUME_SESSION"
                CALL "auth_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:11) = "CHECK_TOKEN"
                CALL "auth_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:17) = "GET_TOKEN_VERSION"
                CALL "auth_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:19) = "MFA_ENROLL_REQUIRED"
                CALL "auth_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:19) = "REVOKE_ACCESS_TOKEN"
                CALL "auth_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:13) = "LIST_SESSIONS"
                CALL "auth_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:19) = "REVOKE_USER_SESSION"
                CALL "auth_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:20) = "REVOKE_ALL_SESSIONS"
                CALL "auth_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:13) = "ARCHIVE_AUDIT"
                CALL "auth_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:10) = "LIST_AUDIT"
                CALL "auth_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE IF CMD-ACTION(1:4) = "PING"
                CALL "auth_core" USING CMD-ACTION CMD-PARAM1 CMD-PARAM2 CMD-PARAM3 CMD-PARAM4 CMD-PARAM5 CMD-PARAM6 WS-OUTPUT-MSG
            ELSE
                MOVE "ERROR|INVALID_ACTION" TO WS-OUTPUT-MSG
            END-IF.
            EXIT PARAGRAPH.

        WRITE-OUTPUT.
            *> Emit WS-OUTPUT-MSG as one or more 500-char records. The gateway
            *> joins the lines back; trailing spaces in each line are padding.
            MOVE 0 TO WS-OUT-LEN
            PERFORM VARYING WS-OUT-I FROM 16384 BY -1 UNTIL WS-OUT-I < 1 OR WS-OUT-LEN > 0
                IF WS-OUTPUT-MSG(WS-OUT-I:1) NOT = SPACE
                    MOVE WS-OUT-I TO WS-OUT-LEN
                END-IF
            END-PERFORM
            IF WS-OUT-LEN = 0
                MOVE SPACES TO OUTPUT-RECORD
                WRITE OUTPUT-RECORD
                EXIT PARAGRAPH
            END-IF
            PERFORM VARYING WS-OUT-POS FROM 1 BY 500 UNTIL WS-OUT-POS > WS-OUT-LEN
                MOVE WS-OUTPUT-MSG(WS-OUT-POS:500) TO OUTPUT-RECORD
                WRITE OUTPUT-RECORD
            END-PERFORM.
            EXIT PARAGRAPH.
