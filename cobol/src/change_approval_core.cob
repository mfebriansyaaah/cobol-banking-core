               EXIT PARAGRAPH
           END-IF
           COMPUTE WS-NUM-AMOUNT = WS-NUM-PRINCIPAL * WS-NUM-RATE / 100
           MOVE SPACES TO WS-RESULT
           STRING "SUCCESS|CHA_CALC|" DELIMITED BY SIZE
                  WS-NUM-AMOUNT DELIMITED BY SIZE
                  INTO WS-RESULT
           END-STRING
           EXIT PARAGRAPH.

