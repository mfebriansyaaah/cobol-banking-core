       IDENTIFICATION DIVISION.
       PROGRAM-ID. report_delivery_core.
      *> Fixed-width report layout and recurring report delivery.

       ENVIRONMENT DIVISION.
       CONFIGURATION SECTION.
       SPECIAL-NAMES.
           DECIMAL-POINT IS COMMA.

       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-RESULT               PIC X(16384) VALUE SPACES.
       01  WS-PREP-SQL             PIC X(1024) VALUE SPACES.
       01  WS-BIND-1               PIC X(256) VALUE SPACES.
       01  WS-BIND-2               PIC X(256) VALUE SPACES.
       01  WS-BIND-3               PIC X(256) VALUE SPACES.
       01  WS-BIND-4               PIC X(256) VALUE SPACES.
       01  WS-BIND-5               PIC X(256) VALUE SPACES.
       01  WS-BIND-6               PIC X(256) VALUE SPACES.
       01  WS-P1-TRIMMED           PIC X(100) VALUE SPACES.
       01  WS-P2-TRIMMED           PIC X(100) VALUE SPACES.
       01  WS-P3-TRIMMED           PIC X(100) VALUE SPACES.
       01  WS-P4-TRIMMED           PIC X(100) VALUE SPACES.
       01  WS-P5-TRIMMED           PIC X(100) VALUE SPACES.
       01  WS-P6-TRIMMED           PIC X(100) VALUE SPACES.
       01  WS-P1-LEN               PIC 9(3) VALUE 1.
       01  WS-P2-LEN               PIC 9(3) VALUE 1.
       01  WS-P3-LEN               PIC 9(3) VALUE 1.
       01  WS-P4-LEN               PIC 9(3) VALUE 1.
       01  WS-P5-LEN               PIC 9(3) VALUE 1.
       01  WS-P6-LEN               PIC 9(3) VALUE 1.
       01  WS-TRIM-IN              PIC X(100) VALUE SPACES.
       01  WS-TRIM-OUT             PIC X(100) VALUE SPACES.
       01  WS-TRIM-LEN             PIC 9(3) VALUE 1.
       01  WS-I                    PIC 9(3) VALUE 1.
       01  WS-J                    PIC 9(5) VALUE 1.
       01  WS-RLEN                 PIC 9(5) VALUE 1.
       01  WS-BAD                  PIC 9(3) VALUE 0.
       01  WS-ALLOWED              PIC 9 VALUE 0.
       01  WS-STEP                 PIC X VALUE 'Y'.
           88  STEP-OK             VALUE 'Y'.
           88  STEP-FAIL           VALUE 'N'.
       01  WS-ERR                  PIC X(40) VALUE SPACES.
       01  WS-TOTAL                PIC X(100) VALUE SPACES.
       01  WS-LIMIT                PIC X(10) VALUE SPACES.
       01  WS-OFFSET               PIC X(10) VALUE SPACES.
       01  WS-LOOKUP-BAD           PIC 9 VALUE 0.
       01  WS-TEMPLATE-ID          PIC X(20) VALUE SPACES.
       01  WS-LAYOUT-WIDTH         PIC X(10) VALUE SPACES.
       01  WS-LAYOUT-HEIGHT        PIC X(10) VALUE SPACES.
       01  WS-LAYOUT-HEADER        PIC X(100) VALUE SPACES.
       01  WS-LAYOUT-FOOTER        PIC X(100) VALUE SPACES.
       01  WS-LAYOUT-ENABLED       PIC X(1) VALUE SPACES.
       01  WS-SCHEDULE-ID          PIC X(20) VALUE SPACES.
       01  WS-SCHEDULE-TEMPLATE    PIC X(40) VALUE SPACES.
       01  WS-SCHEDULE-FREQ        PIC X(10) VALUE SPACES.
       01  WS-SCHEDULE-TIME        PIC X(5) VALUE SPACES.
       01  WS-SCHEDULE-FORMAT      PIC X(10) VALUE SPACES.
       01  WS-SCHEDULE-CURRENCY    PIC X(3) VALUE SPACES.
       01  WS-SCHEDULE-RECIPIENT   PIC X(100) VALUE SPACES.
       01  WS-SCHEDULE-ENABLED     PIC X(1) VALUE SPACES.
       01  WS-SCHEDULE-NEXT        PIC X(10) VALUE SPACES.
       01  WS-RUN-ID               PIC X(20) VALUE SPACES.
       01  WS-RUN-STATUS           PIC X(20) VALUE SPACES.
       01  WS-RUN-TEMPLATE         PIC X(40) VALUE SPACES.
       01  WS-RUN-TITLE            PIC X(100) VALUE SPACES.
       01  WS-RUN-COUNT            PIC X(20) VALUE SPACES.
       01  WS-RUN-DEBIT            PIC X(30) VALUE SPACES.
       01  WS-RUN-CREDIT           PIC X(30) VALUE SPACES.
       01  WS-COUNT-IN             PIC X(30) VALUE SPACES.
       01  WS-COUNT-LEN            PIC 9(3) VALUE 0.
       01  WS-DATE-IN              PIC X(100) VALUE SPACES.
       01  WS-DATE-LEN             PIC 9(3) VALUE 0.
       01  WS-TIME-IN              PIC X(5) VALUE SPACES.
       01  WS-HH                   PIC 99 VALUE 0.
       01  WS-MM                   PIC 99 VALUE 0.
       01  WS-SPEC-FIRST           PIC X(100) VALUE SPACES.
       01  WS-SPEC-SECOND          PIC X(100) VALUE SPACES.
       01  WS-SPEC-NUM             PIC 9(5) VALUE 0.
       01  WS-EMAIL-IN             PIC X(100) VALUE SPACES.
       01  WS-AT-COUNT             PIC 9(3) VALUE 0.
       01  WS-AUDIT-ACTION         PIC X(40) VALUE SPACES.
       01  WS-AUDIT-TEMPLATE       PIC X(40) VALUE SPACES.
       01  WS-AUDIT-RUN            PIC X(20) VALUE SPACES.
       01  WS-AUDIT-DETAIL         PIC X(255) VALUE SPACES.
       01  WS-DENIED-ACTOR         PIC X(100) VALUE SPACES.
       01  WS-DENIED-TARGET        PIC X(40) VALUE SPACES.
       01  WS-CALL-ACTION          PIC X(30) VALUE SPACES.
       01  WS-CALL-P1              PIC X(100) VALUE SPACES.
       01  WS-CALL-P2              PIC X(100) VALUE SPACES.
       01  WS-CALL-P3              PIC X(100) VALUE SPACES.
       01  WS-CALL-P4              PIC X(100) VALUE SPACES.
       01  WS-CALL-P5              PIC X(100) VALUE SPACES.
       01  WS-CALL-P6              PIC X(100) VALUE SPACES.
       01  WS-CALL-OUT             PIC X(16384) VALUE SPACES.
       01  WS-CALL-PART1           PIC X(100) VALUE SPACES.
       01  WS-CALL-PART2           PIC X(100) VALUE SPACES.
       01  WS-CALL-PART3           PIC X(100) VALUE SPACES.
       01  WS-RUN-PARAMS           PIC X(100) VALUE SPACES.
       01  WS-COLUMNS.
           05  WS-COLUMN OCCURS 20 TIMES.
               10  WS-COL-WIDTH    PIC 9(3) VALUE 0.
               10  WS-COL-ALIGN    PIC X(6) VALUE SPACES.
               10  WS-COL-HEADER   PIC X(100) VALUE SPACES.
       01  WS-COL-COUNT            PIC 99 VALUE 0.
       01  WS-COL-RAW              PIC X(16384) VALUE SPACES.
       01  WS-COL-RAWLEN           PIC 9(5) VALUE 0.
       01  WS-COL-PTR              PIC 9(5) VALUE 1.
       01  WS-COL-REC              PIC X(200) VALUE SPACES.
       01  WS-COL-IDX              PIC 99 VALUE 0.
       01  WS-FIELDS.
           05  WS-FIELD OCCURS 20 TIMES PIC X(100).
       01  WS-ROW-RAW              PIC X(16384) VALUE SPACES.
       01  WS-ROW-RAWLEN           PIC 9(5) VALUE 0.
       01  WS-ROW-PTR              PIC 9(5) VALUE 1.
       01  WS-ROW-REC              PIC X(500) VALUE SPACES.
       01  WS-WORK                 PIC X(100) VALUE SPACES.
       01  WS-WORK-LEN             PIC 9(5) VALUE 0.
       01  WS-WIDTH-N              PIC 9(3) VALUE 0.
       01  WS-PADDED               PIC X(240) VALUE SPACES.
       01  WS-START                PIC 9(3) VALUE 1.
       01  WS-LINE                 PIC X(300) VALUE SPACES.
       01  WS-LINE-PTR             PIC 9(5) VALUE 1.
       01  WS-OUT                  PIC X(16000) VALUE SPACES.
       01  WS-OUT-PTR              PIC 9(5) VALUE 1.
       01  WS-OUT-LEN              PIC 9(5) VALUE 1.
       01  WS-OUT-ANY              PIC 9 VALUE 0.
       01  WS-OUT-FULL             PIC 9 VALUE 0.
       01  WS-LAYOUT-TITLE          PIC X(100) VALUE SPACES.
       01  WS-LAYOUT-WIDTH-N        PIC 9(3) VALUE 132.
       01  WS-LAYOUT-HEIGHT-N       PIC 9(3) VALUE 66.
       01  WS-WIDTH-EDIT            PIC ZZ9 VALUE 0.
       01  WS-HEIGHT-EDIT           PIC ZZ9 VALUE 0.
       01  WS-WIDTH-OUT             PIC X(3) VALUE SPACES.
       01  WS-HEIGHT-OUT            PIC X(3) VALUE SPACES.
       01  WS-ALIGN-N               PIC X(6) VALUE SPACES.
       01  WS-ROW-COUNT            PIC 9(3) VALUE 0.
       01  F-QUOTE                 PIC X VALUE "'".
       01  F-DQUOTE                PIC X VALUE '"'.
       01  F-BSLASH                PIC X VALUE "\".
       01  F-SEMI                  PIC X VALUE ";".
       01  F-TICK                  PIC X VALUE "`".

       LINKAGE SECTION.
       01  LS-CMD-ACTION           PIC X(30).
       01  LS-PARAM1               PIC X(100).
       01  LS-PARAM2               PIC X(100).
       01  LS-PARAM3               PIC X(100).
       01  LS-PARAM4               PIC X(100).
       01  LS-PARAM5               PIC X(100).
       01  LS-PARAM6               PIC X(100).
       01  LS-OUTPUT-BUFFER        PIC X(16384).

       PROCEDURE DIVISION USING LS-CMD-ACTION LS-PARAM1 LS-PARAM2
           LS-PARAM3 LS-PARAM4 LS-PARAM5 LS-PARAM6 LS-OUTPUT-BUFFER.

       MAIN-LOGIC.
           PERFORM VALIDATE-ALL
           IF WS-BAD > 0
               MOVE "ERROR|INVALID_INPUT" TO LS-OUTPUT-BUFFER
               GOBACK
           END-IF
           EVALUATE TRUE
               WHEN LS-CMD-ACTION(1:14) = "RDL_LAYOUT_SET"
                   PERFORM TRIM-ALL
                   PERFORM ACTION-LAYOUT-SET
               WHEN LS-CMD-ACTION(1:14) = "RDL_LAYOUT_GET"
                   PERFORM TRIM-ALL
                   PERFORM ACTION-LAYOUT-GET
               WHEN LS-CMD-ACTION(1:15) = "RDL_LAYOUT_LIST"
                   PERFORM TRIM-ALL
                   PERFORM ACTION-LAYOUT-LIST
               WHEN LS-CMD-ACTION(1:17) = "RDL_LAYOUT_RENDER"
                   PERFORM TRIM-ALL
                   PERFORM ACTION-LAYOUT-RENDER
               WHEN LS-CMD-ACTION(1:19) = "RDL_SCHEDULE_CREATE"
                   PERFORM TRIM-ALL
                   PERFORM ACTION-SCHEDULE-CREATE
               WHEN LS-CMD-ACTION(1:17) = "RDL_SCHEDULE_LIST"
                   PERFORM TRIM-ALL
                   PERFORM ACTION-SCHEDULE-LIST
               WHEN LS-CMD-ACTION(1:19) = "RDL_SCHEDULE_UPDATE"
                   PERFORM TRIM-ALL
                   PERFORM ACTION-SCHEDULE-UPDATE
               WHEN LS-CMD-ACTION(1:19) = "RDL_SCHEDULE_DELETE"
                   PERFORM TRIM-ALL
                   PERFORM ACTION-SCHEDULE-DELETE
               WHEN LS-CMD-ACTION(1:16) = "RDL_SCHEDULE_DUE"
                   PERFORM TRIM-ALL
                   PERFORM ACTION-SCHEDULE-DUE
               WHEN LS-CMD-ACTION(1:16) = "RDL_SCHEDULE_RUN"
                   PERFORM TRIM-ALL
                   PERFORM ACTION-SCHEDULE-RUN
               WHEN OTHER
                   MOVE "ERROR|INVALID_ACTION" TO LS-OUTPUT-BUFFER
           END-EVALUATE.
           GOBACK.

       VALIDATE-ALL.
           MOVE 0 TO WS-BAD
           MOVE LS-PARAM1 TO WS-TRIM-IN
           PERFORM VALIDATE-INPUT
           MOVE LS-PARAM2 TO WS-TRIM-IN
           PERFORM VALIDATE-INPUT
           MOVE LS-PARAM3 TO WS-TRIM-IN
           PERFORM VALIDATE-INPUT
           MOVE LS-PARAM4 TO WS-TRIM-IN
           PERFORM VALIDATE-INPUT
           MOVE LS-PARAM5 TO WS-TRIM-IN
           PERFORM VALIDATE-INPUT
           MOVE LS-PARAM6 TO WS-TRIM-IN
           PERFORM VALIDATE-INPUT.
           EXIT PARAGRAPH.

       VALIDATE-INPUT.
           INSPECT WS-TRIM-IN TALLYING WS-BAD FOR ALL F-QUOTE
           INSPECT WS-TRIM-IN TALLYING WS-BAD FOR ALL F-DQUOTE
           INSPECT WS-TRIM-IN TALLYING WS-BAD FOR ALL F-BSLASH
           INSPECT WS-TRIM-IN TALLYING WS-BAD FOR ALL F-SEMI
           INSPECT WS-TRIM-IN TALLYING WS-BAD FOR ALL F-TICK.
           EXIT PARAGRAPH.

       TRIM-ALL.
           MOVE LS-PARAM1 TO WS-TRIM-IN
           PERFORM TRIM-VALUE
           MOVE WS-TRIM-OUT TO WS-P1-TRIMMED
           MOVE WS-TRIM-LEN TO WS-P1-LEN
           MOVE LS-PARAM2 TO WS-TRIM-IN
           PERFORM TRIM-VALUE
           MOVE WS-TRIM-OUT TO WS-P2-TRIMMED
           MOVE WS-TRIM-LEN TO WS-P2-LEN
           MOVE LS-PARAM3 TO WS-TRIM-IN
           PERFORM TRIM-VALUE
           MOVE WS-TRIM-OUT TO WS-P3-TRIMMED
           MOVE WS-TRIM-LEN TO WS-P3-LEN
           MOVE LS-PARAM4 TO WS-TRIM-IN
           PERFORM TRIM-VALUE
           MOVE WS-TRIM-OUT TO WS-P4-TRIMMED
           MOVE WS-TRIM-LEN TO WS-P4-LEN
           MOVE LS-PARAM5 TO WS-TRIM-IN
           PERFORM TRIM-VALUE
           MOVE WS-TRIM-OUT TO WS-P5-TRIMMED
           MOVE WS-TRIM-LEN TO WS-P5-LEN
           MOVE LS-PARAM6 TO WS-TRIM-IN
           PERFORM TRIM-VALUE
           MOVE WS-TRIM-OUT TO WS-P6-TRIMMED
           MOVE WS-TRIM-LEN TO WS-P6-LEN.
           EXIT PARAGRAPH.

       TRIM-VALUE.
           MOVE WS-TRIM-IN TO WS-TRIM-OUT
           MOVE 0 TO WS-TRIM-LEN
           PERFORM VARYING WS-I FROM 100 BY -1
               UNTIL WS-I < 1 OR WS-TRIM-LEN > 0
               IF WS-TRIM-OUT(WS-I:1) NOT = SPACE
                   MOVE WS-I TO WS-TRIM-LEN
               END-IF
           END-PERFORM
           IF WS-TRIM-LEN = 0
               MOVE 1 TO WS-TRIM-LEN
           END-IF.
           EXIT PARAGRAPH.

       TRIM-WORK.
           MOVE 0 TO WS-WORK-LEN
           PERFORM VARYING WS-J FROM 100 BY -1
               UNTIL WS-J < 1 OR WS-WORK-LEN > 0
               IF WS-WORK(WS-J:1) NOT = SPACE
                   MOVE WS-J TO WS-WORK-LEN
               END-IF
           END-PERFORM.
           EXIT PARAGRAPH.

       VALIDATE-DATE-FIELD.
           MOVE 0 TO WS-BAD
           MOVE 0 TO WS-DATE-LEN
           PERFORM VARYING WS-I FROM 100 BY -1
               UNTIL WS-I < 1 OR WS-DATE-LEN > 0
               IF WS-DATE-IN(WS-I:1) NOT = SPACE
                   MOVE WS-I TO WS-DATE-LEN
               END-IF
           END-PERFORM
           IF WS-DATE-LEN NOT = 10
               MOVE 1 TO WS-BAD
           END-IF.
           IF WS-DATE-IN(5:1) NOT = "-" OR WS-DATE-IN(8:1) NOT = "-"
               MOVE 1 TO WS-BAD
           END-IF.
           IF WS-DATE-IN(1:4) IS NOT NUMERIC
              OR WS-DATE-IN(6:2) IS NOT NUMERIC
              OR WS-DATE-IN(9:2) IS NOT NUMERIC
               MOVE 1 TO WS-BAD
           END-IF.
           EXIT PARAGRAPH.

       VALIDATE-TIME-FIELD.
           MOVE 0 TO WS-BAD
           IF WS-TIME-IN(3:1) NOT = ":"
               MOVE 1 TO WS-BAD
           END-IF.
           IF WS-TIME-IN(1:2) IS NOT NUMERIC OR WS-TIME-IN(4:2) IS NOT NUMERIC
               MOVE 1 TO WS-BAD
           END-IF.
           IF WS-BAD = 0
               COMPUTE WS-HH = FUNCTION NUMVAL(WS-TIME-IN(1:2)) END-COMPUTE
               COMPUTE WS-MM = FUNCTION NUMVAL(WS-TIME-IN(4:2)) END-COMPUTE
               IF WS-HH > 23 OR WS-MM > 59
                   MOVE 1 TO WS-BAD
               END-IF
           END-IF.
           EXIT PARAGRAPH.

       VALIDATE-EMAIL-FIELD.
           MOVE 0 TO WS-BAD
           MOVE 0 TO WS-AT-COUNT
           INSPECT WS-EMAIL-IN TALLYING WS-AT-COUNT FOR ALL "@"
           IF WS-AT-COUNT NOT = 1
               MOVE 1 TO WS-BAD
           END-IF.
           IF WS-EMAIL-IN = SPACES
               MOVE 1 TO WS-BAD
           END-IF.
           EXIT PARAGRAPH.

       VALIDATE-COUNT-FIELD.
           MOVE 0 TO WS-BAD
           MOVE 0 TO WS-COUNT-LEN
           PERFORM VARYING WS-I FROM 30 BY -1
               UNTIL WS-I < 1 OR WS-COUNT-LEN > 0
               IF WS-COUNT-IN(WS-I:1) NOT = SPACE
                   MOVE WS-I TO WS-COUNT-LEN
               END-IF
           END-PERFORM
           IF WS-COUNT-LEN < 1 OR WS-COUNT-LEN > 18
               MOVE 1 TO WS-BAD
           END-IF.
           PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > WS-COUNT-LEN
               IF WS-COUNT-IN(WS-I:1) IS NOT NUMERIC
                   MOVE 1 TO WS-BAD
               END-IF
           END-PERFORM.
           EXIT PARAGRAPH.

       ALLOW-ADMIN.
           MOVE 0 TO WS-ALLOWED
           MOVE "SELECT role FROM users WHERE email = ? LIMIT 1" TO WS-PREP-SQL
           MOVE WS-P6-TRIMMED TO WS-BIND-1
           CALL "SQL_PREPARE_EXEC" USING BY REFERENCE WS-PREP-SQL BY VALUE 1
               BY REFERENCE WS-BIND-1 BY REFERENCE WS-BIND-2 BY REFERENCE WS-BIND-3
               BY REFERENCE WS-BIND-4 BY REFERENCE WS-BIND-5 BY REFERENCE WS-BIND-6
           END-CALL
           CALL "GET_RESULT" USING BY REFERENCE WS-RESULT END-CALL
           IF WS-RESULT = "SUPER_ADMIN" OR WS-RESULT = "MANAGER"
               MOVE 1 TO WS-ALLOWED
           END-IF
           IF WS-ALLOWED NOT = 1
               MOVE WS-P6-TRIMMED TO WS-DENIED-ACTOR
               MOVE "REPORT_DELIVERY" TO WS-DENIED-TARGET
               PERFORM AUDIT-DENIED
           END-IF.
           EXIT PARAGRAPH.

       AUDIT-REPORT.
           MOVE "INSERT INTO report_audit (action, actor_email, template_code, run_id, detail) VALUES (?, ?, NULLIF(?, ''), NULLIF(?, ''), ?)" TO WS-PREP-SQL
           MOVE WS-AUDIT-ACTION TO WS-BIND-1
           MOVE WS-P6-TRIMMED TO WS-BIND-2
           MOVE WS-AUDIT-TEMPLATE TO WS-BIND-3
           MOVE WS-AUDIT-RUN TO WS-BIND-4
           MOVE WS-AUDIT-DETAIL TO WS-BIND-5
           CALL "SQL_PREPARE_EXEC" USING BY REFERENCE WS-PREP-SQL BY VALUE 5
               BY REFERENCE WS-BIND-1 BY REFERENCE WS-BIND-2 BY REFERENCE WS-BIND-3
               BY REFERENCE WS-BIND-4 BY REFERENCE WS-BIND-5 BY REFERENCE WS-BIND-6
           END-CALL
           CALL "GET_RESULT" USING BY REFERENCE WS-RESULT END-CALL
           IF WS-RESULT(1:5) = "ERROR"
               SET STEP-FAIL TO TRUE
           END-IF.
           EXIT PARAGRAPH.

       AUDIT-DENIED.
           MOVE "AUTHZ_DENIED" TO WS-AUDIT-ACTION
           MOVE SPACES TO WS-AUDIT-TEMPLATE WS-AUDIT-RUN
           MOVE WS-DENIED-TARGET TO WS-AUDIT-DETAIL
           MOVE WS-DENIED-ACTOR TO WS-P6-TRIMMED
           PERFORM AUDIT-REPORT.
           EXIT PARAGRAPH.

       TRIM-RESULT-LEN.
           MOVE 0 TO WS-RLEN
           PERFORM VARYING WS-J FROM 16384 BY -1
               UNTIL WS-J < 1 OR WS-RLEN > 0
               IF WS-RESULT(WS-J:1) NOT = SPACE
                   MOVE WS-J TO WS-RLEN
               END-IF
           END-PERFORM
           IF WS-RLEN = 0
               MOVE 1 TO WS-RLEN
           END-IF.
           EXIT PARAGRAPH.

       CHECK-TEMPLATE.
           MOVE 0 TO WS-LOOKUP-BAD
           MOVE SPACES TO WS-TEMPLATE-ID
           MOVE "SELECT id FROM report_template WHERE template_code = ? LIMIT 1" TO WS-PREP-SQL
           MOVE WS-P1-TRIMMED TO WS-BIND-1
           CALL "SQL_PREPARE_EXEC" USING BY REFERENCE WS-PREP-SQL BY VALUE 1
               BY REFERENCE WS-BIND-1 BY REFERENCE WS-BIND-2 BY REFERENCE WS-BIND-3
               BY REFERENCE WS-BIND-4 BY REFERENCE WS-BIND-5 BY REFERENCE WS-BIND-6
           END-CALL
           CALL "GET_RESULT" USING BY REFERENCE WS-RESULT END-CALL
           IF WS-RESULT = "ERROR|NO_DATA"
               MOVE 1 TO WS-LOOKUP-BAD
               EXIT PARAGRAPH
           END-IF.
           IF WS-RESULT(1:5) = "ERROR"
               MOVE 2 TO WS-LOOKUP-BAD
               EXIT PARAGRAPH
           END-IF.
           MOVE WS-RESULT(1:20) TO WS-TEMPLATE-ID.
           EXIT PARAGRAPH.

       CHECK-SCHEDULE.
           MOVE 0 TO WS-LOOKUP-BAD
           MOVE SPACES TO WS-SCHEDULE-TEMPLATE WS-SCHEDULE-FREQ
               WS-SCHEDULE-FORMAT WS-SCHEDULE-CURRENCY WS-SCHEDULE-RECIPIENT
               WS-SCHEDULE-ENABLED WS-SCHEDULE-NEXT
           MOVE "SELECT CONCAT(template_code, '|', frequency, '|', output_format, '|', recipient, '|', currency_code, '|', IF(enabled, '1', '0')) FROM report_schedule WHERE id = ? LIMIT 1" TO WS-PREP-SQL
           MOVE WS-P1-TRIMMED TO WS-BIND-1
           CALL "SQL_PREPARE_EXEC" USING BY REFERENCE WS-PREP-SQL BY VALUE 1
               BY REFERENCE WS-BIND-1 BY REFERENCE WS-BIND-2 BY REFERENCE WS-BIND-3
               BY REFERENCE WS-BIND-4 BY REFERENCE WS-BIND-5 BY REFERENCE WS-BIND-6
           END-CALL
           CALL "GET_RESULT" USING BY REFERENCE WS-RESULT END-CALL
           IF WS-RESULT = "ERROR|NO_DATA"
               MOVE 1 TO WS-LOOKUP-BAD
               EXIT PARAGRAPH
           END-IF.
           IF WS-RESULT(1:5) = "ERROR"
               MOVE 2 TO WS-LOOKUP-BAD
               EXIT PARAGRAPH
           END-IF.
           UNSTRING WS-RESULT DELIMITED BY "|" INTO WS-SCHEDULE-TEMPLATE
               WS-SCHEDULE-FREQ WS-SCHEDULE-FORMAT WS-SCHEDULE-RECIPIENT
               WS-SCHEDULE-CURRENCY WS-SCHEDULE-ENABLED
           END-UNSTRING.
           EXIT PARAGRAPH.

       ACTION-LAYOUT-SET.
           PERFORM ALLOW-ADMIN
           IF WS-ALLOWED NOT = 1
               MOVE "ERROR|FORBIDDEN" TO LS-OUTPUT-BUFFER
               EXIT PARAGRAPH
           END-IF.
           IF LS-PARAM1 = SPACES OR LS-PARAM2 = SPACES OR LS-PARAM5 = SPACES
               MOVE "ERROR|INVALID_INPUT" TO LS-OUTPUT-BUFFER
               EXIT PARAGRAPH
           END-IF.
           IF WS-P5-TRIMMED NOT = "0" AND WS-P5-TRIMMED NOT = "1"
               MOVE "ERROR|INVALID_INPUT" TO LS-OUTPUT-BUFFER
               EXIT PARAGRAPH
           END-IF.
           MOVE SPACES TO WS-SPEC-FIRST WS-SPEC-SECOND
           UNSTRING WS-P2-TRIMMED DELIMITED BY "," INTO WS-SPEC-FIRST WS-SPEC-SECOND
           END-UNSTRING
           MOVE WS-SPEC-FIRST(1:30) TO WS-COUNT-IN
           PERFORM VALIDATE-COUNT-FIELD
           IF WS-BAD > 0
               MOVE "ERROR|INVALID_INPUT" TO LS-OUTPUT-BUFFER
               EXIT PARAGRAPH
           END-IF
           COMPUTE WS-SPEC-NUM = FUNCTION NUMVAL(WS-COUNT-IN) END-COMPUTE
           IF WS-SPEC-NUM < 40 OR WS-SPEC-NUM > 240
               MOVE "ERROR|INVALID_INPUT" TO LS-OUTPUT-BUFFER
               EXIT PARAGRAPH
           END-IF
           MOVE WS-SPEC-SECOND(1:30) TO WS-COUNT-IN
           PERFORM VALIDATE-COUNT-FIELD
           IF WS-BAD > 0
               MOVE "ERROR|INVALID_INPUT" TO LS-OUTPUT-BUFFER
               EXIT PARAGRAPH
           END-IF
           COMPUTE WS-SPEC-NUM = FUNCTION NUMVAL(WS-COUNT-IN) END-COMPUTE
           IF WS-SPEC-NUM < 10 OR WS-SPEC-NUM > 200
               MOVE "ERROR|INVALID_INPUT" TO LS-OUTPUT-BUFFER
               EXIT PARAGRAPH
           END-IF.
           PERFORM CHECK-TEMPLATE
           IF WS-LOOKUP-BAD = 1
               MOVE "ERROR|NOT_FOUND" TO LS-OUTPUT-BUFFER
               EXIT PARAGRAPH
           END-IF.
           IF WS-LOOKUP-BAD = 2
               MOVE "ERROR|DB_ERROR" TO LS-OUTPUT-BUFFER
               EXIT PARAGRAPH
           END-IF.
           SET STEP-OK TO TRUE
           CALL "SQL_BEGIN" END-CALL
           MOVE "INSERT INTO report_layout (template_id, page_width, page_length, header_text, footer_text, created_by) VALUES (?, ?, ?, ?, ?, ?) ON DUPLICATE KEY UPDATE page_width=VALUES(page_width), page_length=VALUES(page_length), header_text=VALUES(header_text), footer_text=VALUES(footer_text)" TO WS-PREP-SQL
