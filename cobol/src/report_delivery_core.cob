           MOVE SPACES TO LS-OUTPUT-BUFFER
           IF WS-RESULT = "ERROR|NO_DATA"
               MOVE "SUCCESS|RDL_SCHEDULE_DUE|0" TO LS-OUTPUT-BUFFER
           ELSE
               PERFORM TRIM-RESULT-LEN
               STRING "SUCCESS|RDL_SCHEDULE_DUE|" DELIMITED BY SIZE WS-RESULT(1:WS-RLEN) DELIMITED BY SIZE INTO LS-OUTPUT-BUFFER END-STRING
           END-IF.
           EXIT PARAGRAPH.

       CALL-REPORT-CORE.
           CALL "report_core" USING WS-CALL-ACTION WS-CALL-P1 WS-CALL-P2
               WS-CALL-P3 WS-CALL-P4 WS-CALL-P5 WS-CALL-P6 WS-CALL-OUT
           END-CALL
           MOVE WS-CALL-OUT TO WS-RESULT.
           EXIT PARAGRAPH.

       ACTION-SCHEDULE-RUN.
           PERFORM ALLOW-ADMIN
           IF WS-ALLOWED NOT = 1
               MOVE "ERROR|FORBIDDEN" TO LS-OUTPUT-BUFFER
               EXIT PARAGRAPH
           END-IF.
           IF LS-PARAM1 = SPACES OR LS-PARAM2 = SPACES OR LS-PARAM3 = SPACES
               MOVE "ERROR|INVALID_INPUT" TO LS-OUTPUT-BUFFER
               EXIT PARAGRAPH
           END-IF.
           MOVE WS-P2-TRIMMED TO WS-DATE-IN
           PERFORM VALIDATE-DATE-FIELD
           IF WS-BAD > 0
               MOVE "ERROR|INVALID_INPUT" TO LS-OUTPUT-BUFFER
               EXIT PARAGRAPH
           END-IF.
           MOVE WS-P3-TRIMMED TO WS-DATE-IN
           PERFORM VALIDATE-DATE-FIELD
           IF WS-BAD > 0
               MOVE "ERROR|INVALID_INPUT" TO LS-OUTPUT-BUFFER
               EXIT PARAGRAPH
           END-IF.
           PERFORM CHECK-SCHEDULE
           IF WS-LOOKUP-BAD = 1
               MOVE "ERROR|NOT_FOUND" TO LS-OUTPUT-BUFFER
               EXIT PARAGRAPH
           END-IF.
           IF WS-LOOKUP-BAD = 2
               MOVE "ERROR|DB_ERROR" TO LS-OUTPUT-BUFFER
               EXIT PARAGRAPH
           END-IF.
           IF WS-SCHEDULE-ENABLED NOT = "1"
               MOVE "ERROR|SCHEDULE_DISABLED" TO LS-OUTPUT-BUFFER
               EXIT PARAGRAPH
           END-IF.
           MOVE SPACES TO WS-RUN-PARAMS
           STRING WS-P2-TRIMMED DELIMITED BY SPACE "_" DELIMITED BY SIZE
               WS-P3-TRIMMED DELIMITED BY SPACE INTO WS-RUN-PARAMS END-STRING
           MOVE "RPT_RUN_START" TO WS-CALL-ACTION
           MOVE WS-SCHEDULE-TEMPLATE TO WS-CALL-P1
           MOVE WS-RUN-PARAMS TO WS-CALL-P2
           MOVE SPACES TO WS-CALL-P3 WS-CALL-P4 WS-CALL-P5
           MOVE WS-P6-TRIMMED TO WS-CALL-P6
           PERFORM CALL-REPORT-CORE
           IF WS-RESULT(1:5) = "ERROR"
               MOVE "ERROR|REPORT_RUN_FAILED" TO LS-OUTPUT-BUFFER
               EXIT PARAGRAPH
           END-IF.
           MOVE SPACES TO WS-CALL-PART1 WS-CALL-PART2 WS-RUN-ID
           UNSTRING WS-RESULT DELIMITED BY "|" INTO WS-CALL-PART1
               WS-CALL-PART2 WS-RUN-ID
           END-UNSTRING.
           MOVE "RPT_RUN_GENERATE" TO WS-CALL-ACTION
           MOVE WS-RUN-ID TO WS-CALL-P1
           MOVE WS-P2-TRIMMED TO WS-CALL-P2
           MOVE WS-P3-TRIMMED TO WS-CALL-P3
           MOVE WS-SCHEDULE-CURRENCY TO WS-CALL-P4
           MOVE SPACES TO WS-CALL-P5
           MOVE WS-P6-TRIMMED TO WS-CALL-P6
           PERFORM CALL-REPORT-CORE
           IF WS-RESULT(1:5) = "ERROR"
               MOVE "RPT_RUN_FAIL" TO WS-CALL-ACTION
               MOVE WS-RUN-ID TO WS-CALL-P1
               MOVE "SCHEDULE_FAIL" TO WS-CALL-P2
               MOVE SPACES TO WS-CALL-P3 WS-CALL-P4 WS-CALL-P5
               MOVE WS-P6-TRIMMED TO WS-CALL-P6
               PERFORM CALL-REPORT-CORE
               MOVE "ERROR|REPORT_RUN_FAILED" TO LS-OUTPUT-BUFFER
               EXIT PARAGRAPH
           END-IF.
           MOVE SPACES TO WS-CALL-PART1 WS-CALL-PART2 WS-RUN-COUNT
           UNSTRING WS-RESULT DELIMITED BY "|" INTO WS-CALL-PART1
               WS-CALL-PART2 WS-RUN-COUNT
           END-UNSTRING.
           MOVE "SELECT CONCAT(COUNT(*), ',', COALESCE(SUM(debit), 0), ',', COALESCE(SUM(credit), 0)) FROM report_run_row WHERE run_id = ?" TO WS-PREP-SQL
           MOVE WS-RUN-ID TO WS-BIND-1
           CALL "SQL_PREPARE_EXEC" USING BY REFERENCE WS-PREP-SQL BY VALUE 1
               BY REFERENCE WS-BIND-1 BY REFERENCE WS-BIND-2 BY REFERENCE WS-BIND-3
               BY REFERENCE WS-BIND-4 BY REFERENCE WS-BIND-5 BY REFERENCE WS-BIND-6
           END-CALL
           CALL "GET_RESULT" USING BY REFERENCE WS-RESULT END-CALL
           IF WS-RESULT(1:5) = "ERROR"
               MOVE "ERROR|DB_ERROR" TO LS-OUTPUT-BUFFER
               EXIT PARAGRAPH
           END-IF.
           MOVE SPACES TO WS-RUN-COUNT WS-RUN-DEBIT WS-RUN-CREDIT
           UNSTRING WS-RESULT DELIMITED BY "," INTO WS-RUN-COUNT
               WS-RUN-DEBIT WS-RUN-CREDIT
           END-UNSTRING.
           MOVE "RPT_RUN_COMPLETE" TO WS-CALL-ACTION
           MOVE WS-RUN-ID TO WS-CALL-P1
           MOVE SPACES TO WS-CALL-P2
           STRING WS-RUN-COUNT DELIMITED BY SPACE "," DELIMITED BY SIZE
               WS-RUN-DEBIT DELIMITED BY SPACE "," DELIMITED BY SIZE
               WS-RUN-CREDIT DELIMITED BY SPACE INTO WS-CALL-P2 END-STRING
           MOVE SPACES TO WS-CALL-P3 WS-CALL-P4 WS-CALL-P5
           MOVE WS-P6-TRIMMED TO WS-CALL-P6
           PERFORM CALL-REPORT-CORE
           IF WS-RESULT(1:5) = "ERROR"
               MOVE "ERROR|REPORT_RUN_FAILED" TO LS-OUTPUT-BUFFER
               EXIT PARAGRAPH
           END-IF.
           SET STEP-OK TO TRUE
           CALL "SQL_BEGIN" END-CALL
           MOVE "INSERT INTO notification_outbox (recipient, purpose, code, detail) VALUES (?, 'REPORT', ?, ?)" TO WS-PREP-SQL
           MOVE WS-SCHEDULE-RECIPIENT TO WS-BIND-1
           MOVE WS-SCHEDULE-TEMPLATE(1:20) TO WS-BIND-2
           MOVE SPACES TO WS-AUDIT-DETAIL
           STRING "run:" DELIMITED BY SIZE WS-RUN-ID DELIMITED BY SPACE INTO WS-AUDIT-DETAIL END-STRING
           MOVE WS-AUDIT-DETAIL TO WS-BIND-3
           CALL "SQL_PREPARE_EXEC" USING BY REFERENCE WS-PREP-SQL BY VALUE 3
               BY REFERENCE WS-BIND-1 BY REFERENCE WS-BIND-2 BY REFERENCE WS-BIND-3
               BY REFERENCE WS-BIND-4 BY REFERENCE WS-BIND-5 BY REFERENCE WS-BIND-6
           END-CALL
           CALL "GET_RESULT" USING BY REFERENCE WS-RESULT END-CALL
           IF WS-RESULT(1:5) = "ERROR"
               SET STEP-FAIL TO TRUE
           END-IF.
           IF STEP-OK
               MOVE "UPDATE report_schedule SET last_run_at = NOW(), next_run_date = CASE frequency WHEN 'DAILY' THEN DATE_ADD(CURDATE(), INTERVAL 1 DAY) WHEN 'WEEKLY' THEN DATE_ADD(CURDATE(), INTERVAL 7 DAY) ELSE DATE_ADD(CURDATE(), INTERVAL 1 MONTH) END WHERE id = ?" TO WS-PREP-SQL
               MOVE WS-P1-TRIMMED TO WS-BIND-1
               CALL "SQL_PREPARE_EXEC" USING BY REFERENCE WS-PREP-SQL BY VALUE 1
                   BY REFERENCE WS-BIND-1 BY REFERENCE WS-BIND-2 BY REFERENCE WS-BIND-3
                   BY REFERENCE WS-BIND-4 BY REFERENCE WS-BIND-5 BY REFERENCE WS-BIND-6
               END-CALL
               CALL "GET_RESULT" USING BY REFERENCE WS-RESULT END-CALL
               IF WS-RESULT(1:5) = "ERROR"
                   SET STEP-FAIL TO TRUE
               END-IF
           END-IF.
           IF STEP-OK
               MOVE "SCHEDULE_RUN" TO WS-AUDIT-ACTION
               MOVE WS-SCHEDULE-TEMPLATE TO WS-AUDIT-TEMPLATE
               MOVE WS-RUN-ID TO WS-AUDIT-RUN
               MOVE WS-RUN-PARAMS TO WS-AUDIT-DETAIL
               PERFORM AUDIT-REPORT
           END-IF.
           IF STEP-OK
               CALL "SQL_COMMIT" END-CALL
               MOVE SPACES TO LS-OUTPUT-BUFFER
               STRING "SUCCESS|RDL_SCHEDULE_RUN|" DELIMITED BY SIZE WS-RUN-ID DELIMITED BY SPACE "|" DELIMITED BY SIZE WS-RUN-COUNT DELIMITED BY SPACE INTO LS-OUTPUT-BUFFER END-STRING
           ELSE
               CALL "SQL_ROLLBACK" END-CALL
               MOVE "ERROR|DB_ERROR" TO LS-OUTPUT-BUFFER
           END-IF.
           EXIT PARAGRAPH.

       ACTION-LAYOUT-RENDER.
           PERFORM ALLOW-ADMIN
           IF WS-ALLOWED NOT = 1
               MOVE "ERROR|FORBIDDEN" TO LS-OUTPUT-BUFFER
               EXIT PARAGRAPH
           END-IF.
           IF LS-PARAM1 = SPACES
               MOVE "ERROR|INVALID_INPUT" TO LS-OUTPUT-BUFFER
               EXIT PARAGRAPH
           END-IF.
           MOVE "SELECT CONCAT(r.status, '|', t.template_code, '|', t.title) FROM report_run r JOIN report_template t ON t.id = r.template_id WHERE r.id = ? LIMIT 1" TO WS-PREP-SQL
           MOVE WS-P1-TRIMMED TO WS-BIND-1
           CALL "SQL_PREPARE_EXEC" USING BY REFERENCE WS-PREP-SQL BY VALUE 1
               BY REFERENCE WS-BIND-1 BY REFERENCE WS-BIND-2 BY REFERENCE WS-BIND-3
               BY REFERENCE WS-BIND-4 BY REFERENCE WS-BIND-5 BY REFERENCE WS-BIND-6
           END-CALL
           CALL "GET_RESULT" USING BY REFERENCE WS-RESULT END-CALL
           IF WS-RESULT = "ERROR|NO_DATA"
               MOVE "ERROR|NOT_FOUND" TO LS-OUTPUT-BUFFER
               EXIT PARAGRAPH
           END-IF.
           IF WS-RESULT(1:5) = "ERROR"
               MOVE "ERROR|DB_ERROR" TO LS-OUTPUT-BUFFER
               EXIT PARAGRAPH
           END-IF.
           UNSTRING WS-RESULT DELIMITED BY "|" INTO WS-RUN-STATUS
               WS-RUN-TEMPLATE WS-RUN-TITLE
           END-UNSTRING.
           IF WS-RUN-STATUS NOT = "COMPLETED"
               MOVE "ERROR|INVALID_STATUS" TO LS-OUTPUT-BUFFER
               EXIT PARAGRAPH
           END-IF.
           MOVE 132 TO WS-LAYOUT-WIDTH-N
           MOVE 66 TO WS-LAYOUT-HEIGHT-N
           MOVE WS-RUN-TITLE TO WS-LAYOUT-HEADER
           MOVE SPACES TO WS-LAYOUT-FOOTER
           MOVE "SELECT CONCAT(l.page_width, '|', l.page_length, '|', l.header_text, '|', l.footer_text) FROM report_layout l JOIN report_template t ON t.id = l.template_id WHERE t.template_code = ? LIMIT 1" TO WS-PREP-SQL
           MOVE WS-RUN-TEMPLATE TO WS-BIND-1
           CALL "SQL_PREPARE_EXEC" USING BY REFERENCE WS-PREP-SQL BY VALUE 1
               BY REFERENCE WS-BIND-1 BY REFERENCE WS-BIND-2 BY REFERENCE WS-BIND-3
               BY REFERENCE WS-BIND-4 BY REFERENCE WS-BIND-5 BY REFERENCE WS-BIND-6
           END-CALL
           CALL "GET_RESULT" USING BY REFERENCE WS-RESULT END-CALL
           IF WS-RESULT NOT = "ERROR|NO_DATA"
               IF WS-RESULT(1:5) = "ERROR"
                   MOVE "ERROR|DB_ERROR" TO LS-OUTPUT-BUFFER
                   EXIT PARAGRAPH
               END-IF
               UNSTRING WS-RESULT DELIMITED BY "|" INTO WS-LAYOUT-WIDTH
                   WS-LAYOUT-HEIGHT WS-LAYOUT-HEADER WS-LAYOUT-FOOTER
               END-UNSTRING
               MOVE WS-LAYOUT-WIDTH(1:10) TO WS-COUNT-IN
               PERFORM VALIDATE-COUNT-FIELD
               IF WS-BAD = 0
                   COMPUTE WS-LAYOUT-WIDTH-N = FUNCTION NUMVAL(WS-COUNT-IN) END-COMPUTE
               END-IF
               MOVE WS-LAYOUT-HEIGHT(1:10) TO WS-COUNT-IN
               PERFORM VALIDATE-COUNT-FIELD
               IF WS-BAD = 0
                   COMPUTE WS-LAYOUT-HEIGHT-N = FUNCTION NUMVAL(WS-COUNT-IN) END-COMPUTE
               END-IF
               IF WS-LAYOUT-WIDTH-N < 40 OR WS-LAYOUT-WIDTH-N > 240
                   MOVE 132 TO WS-LAYOUT-WIDTH-N
               END-IF
               IF WS-LAYOUT-HEIGHT-N < 10 OR WS-LAYOUT-HEIGHT-N > 200
                   MOVE 66 TO WS-LAYOUT-HEIGHT-N
               END-IF
               IF WS-LAYOUT-HEADER = SPACES
                   MOVE WS-RUN-TITLE TO WS-LAYOUT-HEADER
               END-IF
           END-IF.
           MOVE "SELECT CONCAT(c.width, '|', c.align, '|', c.header) FROM report_template_column c JOIN report_template t ON t.id = c.template_id WHERE t.template_code = ? ORDER BY c.ordinal" TO WS-PREP-SQL
           MOVE WS-RUN-TEMPLATE TO WS-BIND-1
           CALL "SQL_PREPARE_EXEC_ROWS" USING BY REFERENCE WS-PREP-SQL BY VALUE 1
               BY REFERENCE WS-BIND-1 BY REFERENCE WS-BIND-2 BY REFERENCE WS-BIND-3
               BY REFERENCE WS-BIND-4 BY REFERENCE WS-BIND-5 BY REFERENCE WS-BIND-6
           END-CALL
           CALL "GET_RESULT" USING BY REFERENCE WS-RESULT END-CALL
           IF WS-RESULT = "ERROR|NO_DATA"
               MOVE "ERROR|NO_COLUMNS" TO LS-OUTPUT-BUFFER
               EXIT PARAGRAPH
           END-IF.
           IF WS-RESULT(1:5) = "ERROR"
               MOVE "ERROR|DB_ERROR" TO LS-OUTPUT-BUFFER
               EXIT PARAGRAPH
           END-IF.
           MOVE WS-RESULT TO WS-COL-RAW
           PERFORM TRIM-RESULT-LEN
           MOVE WS-RLEN TO WS-COL-RAWLEN
           MOVE 1 TO WS-COL-PTR
           MOVE 0 TO WS-COL-COUNT
           PERFORM UNTIL WS-COL-COUNT >= 20
               MOVE SPACES TO WS-COL-REC
               UNSTRING WS-COL-RAW DELIMITED BY ";" INTO WS-COL-REC
                   WITH POINTER WS-COL-PTR
               END-UNSTRING
               IF WS-COL-REC = SPACES
                   EXIT PERFORM
               END-IF
               ADD 1 TO WS-COL-COUNT END-ADD
               MOVE 0 TO WS-COL-WIDTH(WS-COL-COUNT)
               MOVE SPACES TO WS-COL-ALIGN(WS-COL-COUNT)
                   WS-COL-HEADER(WS-COL-COUNT)
               UNSTRING WS-COL-REC DELIMITED BY "|" INTO
                   WS-COL-WIDTH(WS-COL-COUNT) WS-COL-ALIGN(WS-COL-COUNT)
                   WS-COL-HEADER(WS-COL-COUNT)
               END-UNSTRING
               IF WS-COL-PTR > WS-COL-RAWLEN
                   EXIT PERFORM
               END-IF
           END-PERFORM.
           IF WS-COL-COUNT = 0
               MOVE "ERROR|NO_COLUMNS" TO LS-OUTPUT-BUFFER
               EXIT PARAGRAPH
           END-IF.
           MOVE "SELECT row_data FROM report_run_row WHERE run_id = ? ORDER BY ordinal LIMIT 100" TO WS-PREP-SQL
           MOVE WS-P1-TRIMMED TO WS-BIND-1
           CALL "SQL_PREPARE_EXEC_ROWS" USING BY REFERENCE WS-PREP-SQL BY VALUE 1
               BY REFERENCE WS-BIND-1 BY REFERENCE WS-BIND-2 BY REFERENCE WS-BIND-3
               BY REFERENCE WS-BIND-4 BY REFERENCE WS-BIND-5 BY REFERENCE WS-BIND-6
           END-CALL
           CALL "GET_RESULT" USING BY REFERENCE WS-RESULT END-CALL
           MOVE SPACES TO WS-ROW-RAW
           IF WS-RESULT NOT = "ERROR|NO_DATA"
               IF WS-RESULT(1:5) = "ERROR"
                   MOVE "ERROR|DB_ERROR" TO LS-OUTPUT-BUFFER
                   EXIT PARAGRAPH
               END-IF
               MOVE WS-RESULT TO WS-ROW-RAW
           END-IF.
           MOVE SPACES TO WS-OUT
           MOVE 1 TO WS-OUT-PTR
           MOVE 0 TO WS-OUT-ANY
           MOVE SPACES TO WS-LINE
           MOVE WS-LAYOUT-HEADER TO WS-WORK
           PERFORM TRIM-WORK
           MOVE "LEFT" TO WS-ALIGN-N
           MOVE WS-LAYOUT-WIDTH-N TO WS-WIDTH-N
           PERFORM BUILD-PADDED
           MOVE WS-PADDED(1:WS-LAYOUT-WIDTH-N) TO WS-LINE
           MOVE WS-LAYOUT-WIDTH-N TO WS-LINE-PTR
           PERFORM APPEND-LINE
           MOVE SPACES TO WS-LINE
           MOVE 1 TO WS-LINE-PTR
           PERFORM VARYING WS-COL-IDX FROM 1 BY 1
               UNTIL WS-COL-IDX > WS-COL-COUNT
               MOVE WS-COL-HEADER(WS-COL-IDX) TO WS-WORK
               PERFORM TRIM-WORK
               MOVE WS-COL-WIDTH(WS-COL-IDX) TO WS-WIDTH-N
               MOVE WS-COL-ALIGN(WS-COL-IDX) TO WS-ALIGN-N
               PERFORM BUILD-PADDED
               STRING WS-PADDED(1:WS-WIDTH-N) DELIMITED BY SIZE
                   INTO WS-LINE WITH POINTER WS-LINE-PTR
               END-STRING
           END-PERFORM
           MOVE WS-LINE(1:WS-LAYOUT-WIDTH-N)
               TO WS-PADDED(1:WS-LAYOUT-WIDTH-N)
           MOVE WS-PADDED(1:WS-LAYOUT-WIDTH-N) TO WS-LINE
           MOVE WS-LAYOUT-WIDTH-N TO WS-LINE-PTR
           PERFORM APPEND-LINE
           MOVE SPACES TO WS-ROW-RAW
           IF WS-RESULT NOT = "ERROR|NO_DATA"
               MOVE WS-RESULT TO WS-ROW-RAW
           END-IF
           PERFORM TRIM-RESULT-LEN
           MOVE WS-RLEN TO WS-ROW-RAWLEN
           MOVE 1 TO WS-ROW-PTR
           MOVE 0 TO WS-ROW-COUNT
           PERFORM UNTIL WS-ROW-COUNT >= 100
               MOVE SPACES TO WS-ROW-REC
               UNSTRING WS-ROW-RAW DELIMITED BY ";" INTO WS-ROW-REC
                   WITH POINTER WS-ROW-PTR
               END-UNSTRING
               IF WS-ROW-REC = SPACES
                   EXIT PERFORM
               END-IF
               ADD 1 TO WS-ROW-COUNT END-ADD
               INITIALIZE WS-FIELDS
               UNSTRING WS-ROW-REC DELIMITED BY ","
                   INTO WS-FIELD(1) WS-FIELD(2) WS-FIELD(3) WS-FIELD(4)
                        WS-FIELD(5) WS-FIELD(6) WS-FIELD(7) WS-FIELD(8)
                        WS-FIELD(9) WS-FIELD(10) WS-FIELD(11) WS-FIELD(12)
                        WS-FIELD(13) WS-FIELD(14) WS-FIELD(15) WS-FIELD(16)
                        WS-FIELD(17) WS-FIELD(18) WS-FIELD(19) WS-FIELD(20)
               END-UNSTRING
               MOVE SPACES TO WS-LINE
               MOVE 1 TO WS-LINE-PTR
               PERFORM VARYING WS-COL-IDX FROM 1 BY 1
                   UNTIL WS-COL-IDX > WS-COL-COUNT
                   MOVE WS-FIELD(WS-COL-IDX) TO WS-WORK
                   PERFORM TRIM-WORK
                   MOVE WS-COL-WIDTH(WS-COL-IDX) TO WS-WIDTH-N
                   MOVE WS-COL-ALIGN(WS-COL-IDX) TO WS-ALIGN-N
                   PERFORM BUILD-PADDED
                   STRING WS-PADDED(1:WS-WIDTH-N) DELIMITED BY SIZE
                       INTO WS-LINE WITH POINTER WS-LINE-PTR
                   END-STRING
               END-PERFORM
               MOVE WS-LINE(1:WS-LAYOUT-WIDTH-N)
                   TO WS-PADDED(1:WS-LAYOUT-WIDTH-N)
               MOVE WS-PADDED(1:WS-LAYOUT-WIDTH-N) TO WS-LINE
               MOVE WS-LAYOUT-WIDTH-N TO WS-LINE-PTR
               PERFORM APPEND-LINE
               IF WS-ROW-PTR > WS-ROW-RAWLEN
                   EXIT PERFORM
               END-IF
           END-PERFORM.
           MOVE SPACES TO WS-LINE
           MOVE WS-LAYOUT-FOOTER TO WS-WORK
           PERFORM TRIM-WORK
           IF WS-WORK-LEN > 0
               MOVE "LEFT" TO WS-ALIGN-N
               MOVE WS-LAYOUT-WIDTH-N TO WS-WIDTH-N
               PERFORM BUILD-PADDED
               MOVE WS-PADDED(1:WS-LAYOUT-WIDTH-N) TO WS-LINE
               MOVE WS-LAYOUT-WIDTH-N TO WS-LINE-PTR
               PERFORM APPEND-LINE
           END-IF.
           IF WS-OUT-PTR > 1
               COMPUTE WS-OUT-LEN = WS-OUT-PTR - 1 END-COMPUTE
           ELSE
               MOVE 0 TO WS-OUT-LEN
           END-IF.
           MOVE WS-LAYOUT-WIDTH-N TO WS-WIDTH-EDIT
           MOVE FUNCTION TRIM(WS-WIDTH-EDIT) TO WS-WIDTH-OUT
           MOVE WS-LAYOUT-HEIGHT-N TO WS-HEIGHT-EDIT
           MOVE FUNCTION TRIM(WS-HEIGHT-EDIT) TO WS-HEIGHT-OUT
           MOVE SPACES TO LS-OUTPUT-BUFFER
           STRING "SUCCESS|RDL_LAYOUT_RENDER|" DELIMITED BY SIZE
               WS-WIDTH-OUT DELIMITED BY SPACE "|" DELIMITED BY SIZE
               WS-HEIGHT-OUT DELIMITED BY SPACE "|" DELIMITED BY SIZE
               WS-OUT(1:WS-OUT-LEN) DELIMITED BY SIZE
               INTO LS-OUTPUT-BUFFER
           END-STRING.
           EXIT PARAGRAPH.

       BUILD-PADDED.
           MOVE SPACES TO WS-PADDED
           IF WS-WORK-LEN > 0
               IF WS-WORK-LEN >= WS-WIDTH-N
                   MOVE WS-WORK(1:WS-WIDTH-N) TO WS-PADDED
               ELSE
                   EVALUATE WS-ALIGN-N
                       WHEN "RIGHT"
                           COMPUTE WS-START = WS-WIDTH-N - WS-WORK-LEN + 1 END-COMPUTE
                           MOVE WS-WORK(1:WS-WORK-LEN)
                               TO WS-PADDED(WS-START:WS-WORK-LEN)
                       WHEN "CENTER"
                           COMPUTE WS-START =
                               (WS-WIDTH-N - WS-WORK-LEN) / 2 + 1
                           END-COMPUTE
                           MOVE WS-WORK(1:WS-WORK-LEN)
                               TO WS-PADDED(WS-START:WS-WORK-LEN)
                       WHEN OTHER
                           MOVE WS-WORK(1:WS-WORK-LEN)
                               TO WS-PADDED(1:WS-WORK-LEN)
                   END-EVALUATE
               END-IF
           END-IF.
           EXIT PARAGRAPH.

       APPEND-LINE.
           IF WS-OUT-FULL = 1
               EXIT PARAGRAPH
           END-IF
           IF WS-OUT-ANY = 1
               STRING "~" DELIMITED BY SIZE INTO WS-OUT
                   WITH POINTER WS-OUT-PTR
               END-STRING
           END-IF
           MOVE 1 TO WS-OUT-ANY
           IF WS-LINE-PTR > 1
               COMPUTE WS-START = WS-LINE-PTR - 1 END-COMPUTE
           ELSE
               MOVE 0 TO WS-START
           END-IF
           IF WS-START > 0
               IF WS-OUT-PTR + WS-START <= 15990
                   STRING WS-LINE(1:WS-START) DELIMITED BY SIZE
                       INTO WS-OUT WITH POINTER WS-OUT-PTR
                   END-STRING
               ELSE
                   STRING "~TRUNCATED" DELIMITED BY SIZE INTO WS-OUT
                       WITH POINTER WS-OUT-PTR
                   END-STRING
                   MOVE 1 TO WS-OUT-FULL
               END-IF
           END-IF.
           EXIT PARAGRAPH.
