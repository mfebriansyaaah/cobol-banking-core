; odbc.ini - Konfigurasi Data Source Name (DSN) untuk MySQL
; Simpan file ini sebagai odbc.ini di folder cobol/config/
; Di Windows: Letakkan di %WINDIR%\System32\odbc.ini atau set environment variable ODBCINI
; Di Linux: Letakkan di /etc/odbc.ini atau ~/.odbc.ini

[COBOL_MYSQL]
Description     = MySQL connection for COBOL Application
Driver          = MySQL ODBC 8.0 Unicode Driver
Server          = localhost
Port            = 3306
Database        = cobol_db
User            = cobol_user
Password        = cobol_pass
Option          = 3
Charset         = utf8mb4
; SSL settings (uncomment jika menggunakan SSL)
; SSL_CA        = /path/to/ca.pem
; SSL_CERT      = /path/to/client-cert.pem
; SSL_KEY       = /path/to/client-key.pem
; SSL_VERIFY    = 1