      *> Shared SQL exec wrappers (DRY-06A): one paragraph per arity.
      *> Each paragraph runs the prepared statement and fetches the result,
      *> exactly like the inline CALL "SQL_PREPARE_EXEC*" + GET_RESULT it
      *> replaces. The caller stages WS-PREP-SQL first, then MOVEs values to
      *> WS-BIND-1..n (exactly 1..n, in order), then PERFORMs SQL-EXEC-n
      *> (or SQL-EXEC-ROWS-n for multi-row reads). Requires WS-PREP-SQL,
      *> WS-BIND-1..6 and WS-RESULT. Hosts with fewer bind slots use their
      *> own footprint file (sql_exec_5.cpy / sql_exec_4.cpy). Only arities
      *> already converted may be listed here: an unperformed paragraph is
      *> a dead paragraph and fails check_copybooks.
       SQL-EXEC-1.
           CALL "SQL_PREPARE_EXEC" USING BY REFERENCE WS-PREP-SQL BY VALUE 1
               BY REFERENCE WS-BIND-1
           END-CALL
           CALL "GET_RESULT" USING BY REFERENCE WS-RESULT END-CALL.
           EXIT PARAGRAPH.

       SQL-EXEC-2.
           CALL "SQL_PREPARE_EXEC" USING BY REFERENCE WS-PREP-SQL BY VALUE 2
               BY REFERENCE WS-BIND-1 BY REFERENCE WS-BIND-2
           END-CALL
           CALL "GET_RESULT" USING BY REFERENCE WS-RESULT END-CALL.
           EXIT PARAGRAPH.

       SQL-EXEC-3.
           CALL "SQL_PREPARE_EXEC" USING BY REFERENCE WS-PREP-SQL BY VALUE 3
               BY REFERENCE WS-BIND-1 BY REFERENCE WS-BIND-2 BY REFERENCE WS-BIND-3
           END-CALL
           CALL "GET_RESULT" USING BY REFERENCE WS-RESULT END-CALL.
           EXIT PARAGRAPH.

       SQL-EXEC-4.
           CALL "SQL_PREPARE_EXEC" USING BY REFERENCE WS-PREP-SQL BY VALUE 4
               BY REFERENCE WS-BIND-1 BY REFERENCE WS-BIND-2 BY REFERENCE WS-BIND-3
               BY REFERENCE WS-BIND-4
           END-CALL
           CALL "GET_RESULT" USING BY REFERENCE WS-RESULT END-CALL.
           EXIT PARAGRAPH.

       SQL-EXEC-5.
           CALL "SQL_PREPARE_EXEC" USING BY REFERENCE WS-PREP-SQL BY VALUE 5
               BY REFERENCE WS-BIND-1 BY REFERENCE WS-BIND-2 BY REFERENCE WS-BIND-3
               BY REFERENCE WS-BIND-4 BY REFERENCE WS-BIND-5
           END-CALL
           CALL "GET_RESULT" USING BY REFERENCE WS-RESULT END-CALL.
           EXIT PARAGRAPH.

       SQL-EXEC-6.
           CALL "SQL_PREPARE_EXEC" USING BY REFERENCE WS-PREP-SQL BY VALUE 6
               BY REFERENCE WS-BIND-1 BY REFERENCE WS-BIND-2 BY REFERENCE WS-BIND-3
               BY REFERENCE WS-BIND-4 BY REFERENCE WS-BIND-5 BY REFERENCE WS-BIND-6
           END-CALL
           CALL "GET_RESULT" USING BY REFERENCE WS-RESULT END-CALL.
           EXIT PARAGRAPH.

       SQL-EXEC-ROWS-1.
           CALL "SQL_PREPARE_EXEC_ROWS" USING BY REFERENCE WS-PREP-SQL BY VALUE 1
               BY REFERENCE WS-BIND-1
           END-CALL
           CALL "GET_RESULT" USING BY REFERENCE WS-RESULT END-CALL.
           EXIT PARAGRAPH.

       SQL-EXEC-ROWS-3.
           CALL "SQL_PREPARE_EXEC_ROWS" USING BY REFERENCE WS-PREP-SQL BY VALUE 3
               BY REFERENCE WS-BIND-1 BY REFERENCE WS-BIND-2 BY REFERENCE WS-BIND-3
           END-CALL
           CALL "GET_RESULT" USING BY REFERENCE WS-RESULT END-CALL.
           EXIT PARAGRAPH.

       SQL-EXEC-ROWS-4.
           CALL "SQL_PREPARE_EXEC_ROWS" USING BY REFERENCE WS-PREP-SQL BY VALUE 4
               BY REFERENCE WS-BIND-1 BY REFERENCE WS-BIND-2 BY REFERENCE WS-BIND-3
               BY REFERENCE WS-BIND-4
           END-CALL
           CALL "GET_RESULT" USING BY REFERENCE WS-RESULT END-CALL.
           EXIT PARAGRAPH.

       SQL-EXEC-ROWS-6.
           CALL "SQL_PREPARE_EXEC_ROWS" USING BY REFERENCE WS-PREP-SQL BY VALUE 6
               BY REFERENCE WS-BIND-1 BY REFERENCE WS-BIND-2 BY REFERENCE WS-BIND-3
               BY REFERENCE WS-BIND-4 BY REFERENCE WS-BIND-5 BY REFERENCE WS-BIND-6
           END-CALL
           CALL "GET_RESULT" USING BY REFERENCE WS-RESULT END-CALL.
           EXIT PARAGRAPH.
