# Binary and Object files
*.o
*.so
cobol/bin/
cobol/bin/*.o
cobol/bin/main_logic
cobol/build/

# I/O and temporary files
input.txt
output.txt

# Database dumps (scripts/backup.sh default output; never commit customer data)
backups/

# Configuration and Secrets
tests/.dbenv

# OS generated files
.DS_Store
Thumbs.db
sql_debug.log

# Node
node_modules/
middleware/node_modules/

# Kept failure logs (run_all.sh --keep-logs); never commit these.
tests/artifacts/

# Coverage reports
coverage/
# ...but not the coverage tooling itself
!scripts/coverage/

# Machine-readable test reports (tests/lib/report.sh, JUnit, JSON summaries)
artifacts/
middleware/test-results/

# Pre-merge evidence artifact (scripts/ci/premerge.sh); attached to PRs, never committed.
premerge-report.json

# Python bytecode caches
__pycache__/

# Per-run benchmark reports (regenerate with tests/perf/bench.sh).
tests/perf/last.json
