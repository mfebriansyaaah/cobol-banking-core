{
  "name": "cobol-banking-api-gateway",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Robust pipe: the only HTTP interface to the COBOL banking core.",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --import ./preload.mjs --test $(node ../scripts/ci/quarantine_flag.mjs) --test-reporter=spec $(node scripts/test-files.mjs full)",
    "test:fast": "node --import ./preload.mjs --test $(node ../scripts/ci/quarantine_flag.mjs) --test-reporter=spec $(node scripts/test-files.mjs fast)",
    "test:unit": "node --import ./preload.mjs --test --test-reporter=spec $(node scripts/test-files.mjs unit)",
    "test:db": "node --import ./preload.mjs --test $(node ../scripts/ci/quarantine_flag.mjs) --test-concurrency=1 --test-reporter=spec $(node scripts/test-files.mjs db)",
    "test:endpoints": "node --import ./preload.gateway.mjs --test $(node ../scripts/ci/quarantine_flag.mjs) --test-reporter=spec $(node scripts/test-files.mjs endpoints)",
    "test:gateway": "node --import ./preload.gateway.mjs --test $(node ../scripts/ci/quarantine_flag.mjs) --test-reporter=spec $(node scripts/test-files.mjs gateway)",
    "test:coverage": "node --import ./preload.mjs --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=70 --test-coverage-include='src/**'",
    "test:junit": "mkdir -p \"${TEST_REPORT_DIR:-./test-results}\" && node --import ./preload.mjs --test $(node ../scripts/ci/quarantine_flag.mjs) --test-reporter=spec --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=\"${TEST_REPORT_DIR:-./test-results}/junit-full.xml\"",
    "test:unit:junit": "mkdir -p \"${TEST_REPORT_DIR:-./test-results}\" && node --import ./preload.mjs --test --test-reporter=spec --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=\"${TEST_REPORT_DIR:-./test-results}/junit-unit.xml\" $(node scripts/test-files.mjs unit)",
    "test:db:junit": "mkdir -p \"${TEST_REPORT_DIR:-./test-results}\" && node --import ./preload.mjs --test $(node ../scripts/ci/quarantine_flag.mjs) --test-concurrency=1 --test-reporter=spec --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=\"${TEST_REPORT_DIR:-./test-results}/junit-db.xml\" $(node scripts/test-files.mjs db)",
    "test:fast:junit": "mkdir -p \"${TEST_REPORT_DIR:-./test-results}\" && node --import ./preload.mjs --test $(node ../scripts/ci/quarantine_flag.mjs) --test-reporter=spec --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=\"${TEST_REPORT_DIR:-./test-results}/junit-fast.xml\" $(node scripts/test-files.mjs fast)",
    "test:endpoints:junit": "mkdir -p \"${TEST_REPORT_DIR:-./test-results}\" && node --import ./preload.gateway.mjs --test $(node ../scripts/ci/quarantine_flag.mjs) --test-reporter=spec --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=\"${TEST_REPORT_DIR:-./test-results}/junit-endpoints.xml\" $(node scripts/test-files.mjs endpoints)",
    "test:gateway:junit": "mkdir -p \"${TEST_REPORT_DIR:-./test-results}\" && node --import ./preload.gateway.mjs --test $(node ../scripts/ci/quarantine_flag.mjs) --test-reporter=spec --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=\"${TEST_REPORT_DIR:-./test-results}/junit-gateway.xml\" $(node scripts/test-files.mjs gateway)",
    "lint": "npm --prefix .. run lint",
    "format:check": "npm --prefix .. run format:check"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.3.1",
    "redis": "^6.3.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
