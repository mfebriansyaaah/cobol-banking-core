# Environment for the api-gateway.
PORT=3000

# In production the server refuses to start unless JWT_SECRET and REFRESH_SECRET
# are each at least 32 characters, differ from the development defaults below,
# and differ from each other.
NODE_ENV=development

# Access token (short-lived) and refresh token (long-lived, separate secret).
# Tokens carry this issuer and audience; verification enforces both, so they
# must match on every gateway instance (and on any external verifier).
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_ISSUER=cobol-banking-core
JWT_AUDIENCE=cobol-banking-api
REFRESH_SECRET=change-me-too-in-production
REFRESH_EXPIRES_IN=7d
# Refresh sessions live this many days (rolling expiry on the row).
REFRESH_TTL_DAYS=7

# Refresh family limits (enforced by CONSUME_SESSION): a family is force-expired
# after this many days and after this many rotations, whichever comes first.
# Set either to 0 to disable that check.
REFRESH_ABSOLUTE_TTL_DAYS=30
REFRESH_MAX_ROTATIONS=100

# Short-lived step-up (re-authentication) proof lifetime, in seconds. Privileged
# admin writes require a fresh proof from POST /auth/step-up (X-Step-Up header).
STEP_UP_TTL_SECONDS=300

# Overlapping secret rotation: stage the pre-rotation value here plus its
# deadline (unix epoch seconds), restart with the new primary secret, and
# tokens minted before the restart keep verifying until *_PREVIOUS_UNTIL
# passes. Signing always uses the primary secret. A previous secret is only
# honored while its deadline is in the future, so the old value stops being
# accepted on schedule even if it is left configured; production refuses to
# start when a previous secret is set without a valid deadline. Empty
# (default) disables the fallback. See docs/runbooks/secret-rotation.md.
JWT_SECRET_PREVIOUS=
JWT_SECRET_PREVIOUS_UNTIL=
REFRESH_SECRET_PREVIOUS=
REFRESH_SECRET_PREVIOUS_UNTIL=

# Issuer shown in the TOTP provisioning URI (authenticator apps display it
# next to the account name). Cosmetic only; changing it does not invalidate
# enrolled secrets.
MFA_ISSUER=CobolBank

# Rate limiting for /auth/* endpoints (fixed window per client).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Auth endpoints fail closed when the counter store is unavailable (true/false).
# API endpoints keep fail-open to preserve availability.
RATE_LIMIT_FAIL_OPEN=false

# Per-account resend cooldown in seconds: requesting a fresh signup or
# password-reset code inside the window neutrally reuses the pending one
# (no new code, no new email). Set to 0 to reissue on every request.
RESEND_COOLDOWN_SECONDS=60

# Password history bound: a change or reset refuses the current password and
# the last N stored ones. Set to 0 to disable the history check (the deny list
# still applies). The production deny list is owner-controlled data.
PASSWORD_HISTORY_COUNT=5

# Dormant account lifecycle (ADR 0080). DORMANT_AFTER_DAYS=0 disables it;
# when enabled, MARK_DORMANT warns accounts idle longer than the window and
# SUSPEND_DORMANT suspends them after the grace window. SUPER_ADMIN accounts
# are never auto-suspended.
DORMANT_AFTER_DAYS=0
DORMANT_GRACE_DAYS=14

# Administrator idle bound in seconds: a refresh whose previous activity is
# older than this is refused for SUPER_ADMIN/MANAGER accounts (the family is
# revoked and the tokens die). The access-token lifetime bounds the residual
# window between refreshes. Set to 0 to disable the bound.
ADMIN_IDLE_TIMEOUT_SECONDS=1800

# Distributed rate limiting: set REDIS_URL to share the counters across gateway
# instances (otherwise each process counts separately). Behind a proxy set
# TRUST_PROXY (e.g. 1 or "loopback") so the client IP comes from the forwarded
# headers and is used as the rate-limit key. Use the number of trusted hops,
# never "true" (that trusts any X-Forwarded-For and lets callers spoof the
# rate-limit key); when unset behind a proxy, every client shares one key.
# Production startup logs a warning when the setting looks wrong.
REDIS_URL=
TRUST_PROXY=

# JSON body cap: legitimate requests carry short credential/profile fields, so
# anything larger is rejected with 413 before it is parsed or reaches COBOL.
JSON_BODY_LIMIT=20kb

# Rate limiting for non-auth endpoints (more generous fixed window per client).
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=600

# Public probe (/ready) dependency-check cache in ms, to bound the DB round-trips
# an anonymous caller can trigger. /health and /ready also use the API limiter.
PROBE_CACHE_MS=1000

# Absolute path to the COBOL binary; defaults to ../../cobol/bin/main_logic
COBOL_BIN=

# Worker pool over the binary's serve mode (ADR-0010). 0 keeps file mode
# (one process per request). COBOL_POOL_PIPELINE is the in-flight cap per worker.
# Every value is validated at startup: a non-integer or out-of-range setting
# refuses to boot rather than hanging requests. COBOL_POOL_QUEUE_MAX bounds the
# waiting queue; a request arriving at a full queue is rejected with 503
# (POOL_SATURATED) instead of accumulating, and a request that waits longer
# than the timeout is rejected with 504.
COBOL_POOL_SIZE=0
COBOL_POOL_TIMEOUT_MS=5000
COBOL_POOL_PIPELINE=1
COBOL_POOL_QUEUE_MAX=100

# Metrics export: when set, the gateway periodically POSTs the Prometheus text
# from /metrics to this collector (e.g. a Pushgateway or OTLP-HTTP bridge).
METRICS_PUSH_URL=
METRICS_PUSH_INTERVAL_MS=15000

# Limits enforced by the COBOL core (inherited through the gateway's
# environment). Transfer caps are whole units of the sender's currency,
# digits only (a dotted or malformed value fails closed: every transfer is
# refused with LIMIT_EXCEEDED), and off by default (0); intents older than
# the retention window are archived (0 disables the archive sweep).
TRANSFER_MAX_PER_TXN=0
TRANSFER_DAILY_LIMIT=0
PENDING_RETENTION_DAYS=30
RATE_MAX_AGE_SECONDS=86400

# Database connection for the COBOL binary, inherited from this process by the
# C bridge. Defaults match the development database; set these per deployment.
# In production the gateway refuses to start unless DB_HOST, DB_USER, DB_PASS
# and DB_NAME are set explicitly and the credentials differ from these
# development defaults.
# In production DB_USER should be the DML-only application account (no DDL),
# provisioned by database/grants.sh; schema migrations run under a separate
# privileged account.
DB_HOST=localhost
DB_PORT=3306
DB_USER=cobol_user
DB_PASS=cobol_pass
DB_NAME=cobol_db

# Verification codes are queued in the transactional outbox, never in the HTTP
# response. The dispatch worker (scripts/outbox_worker.sh, run on a schedule)
# sends them from this table: SMTP when configured, otherwise the rows stay
# PENDING/FAILED and age into dead-letter rows. MAIL_DEBUG=1 additionally
# logs the code outside production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_TIMEOUT_MS=10000
MAIL_FROM=no-reply@cobol-banking.local
MAIL_FROM_NAME=
MAIL_DEBUG=

# Outbox dispatch: transport smtp (production) or log with OUTBOX_LOG_FILE
# (development/tests only — it marks mail delivered). OUTBOX_MAX_ATTEMPTS
# bounds delivery attempts before a row goes dead-letter.
OUTBOX_TRANSPORT=smtp
OUTBOX_LOG_FILE=
OUTBOX_MAX_ATTEMPTS=5

# Integration providers (PR-080): one switchboard for every external
# channel. Unknown values fail at boot; production without the secrets
# below fails at boot. Development defaults need zero external services.
INTEGRATION_MODE=local
EMAIL_PROVIDER=log
PHONE_OTP_PROVIDER=mock
IDENTITY_PROVIDER=mock
KTP_OCR_PROVIDER=mock
MAILPIT_HOST=
TELEGRAM_BOT_TOKEN=
# Test seam only (PR-088): point at the local fake. Never a real host in tests.
TELEGRAM_API_BASE=
TELEGRAM_TIMEOUT_MS=10000
FREE_SMS_ENDPOINT=
FREE_SMS_API_KEY=
FREE_SMS_SENDER=cobol-banking
FREE_SMS_TIMEOUT_MS=10000

# Production secrets (PR-089): .env is dev-only; production injects these via
# the secret manager and boot fails without them (see assertSecrets).
# Rotation = rotate in the manager, restart the gateway.

# Identity verification (PR-083): local structural NIK only by default.
# NUSAKIT_* enables the optional remote adapter (explicit consent per call).
NIK_MIN_AGE=17
NUSAKIT_ENDPOINT=
NUSAKIT_ALLOWLIST=
NIK_HMAC_SECRET=

# Free-tier quota guard (PR-089): daily per-provider budgets; 0 disables the
# provider (kill switch, callers fall back). Alert at 80%.
QUOTA_TELEGRAM_DAILY=1000
QUOTA_FREE_SMS_DAILY=100
QUOTA_NUSAKIT_DAILY=500
QUOTA_SMTP_DAILY=1000

# Breached-password check (PR-093): k-anonymity range API. Fail-open on
# down/timeout (metric). Enforced with PWNED_ENFORCE=1 (or by default in
# production unless PWNED_DISABLE=1); unit suites stay offline otherwise.
PWNED_ENDPOINT=
PWNED_TIMEOUT_MS=2000
# PWNED_ENFORCE=1
# PWNED_DISABLE=1
