# Environment for the api-gateway.
PORT=3000

# In production the server refuses to start unless JWT_SECRET and REFRESH_SECRET
# are each at least 32 characters, differ from the development defaults below,
# and differ from each other.
NODE_ENV=development

# Access token (short-lived) and refresh token (long-lived, separate secret).
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
REFRESH_SECRET=change-me-too-in-production
REFRESH_EXPIRES_IN=7d

# Refresh family limits (enforced by CONSUME_SESSION): a family is force-expired
# after this many days and after this many rotations, whichever comes first.
# Set either to 0 to disable that check.
REFRESH_ABSOLUTE_TTL_DAYS=30
REFRESH_MAX_ROTATIONS=100

# Short-lived step-up (re-authentication) proof lifetime, in seconds. Privileged
# admin writes require a fresh proof from POST /auth/step-up (X-Step-Up header).
STEP_UP_TTL_SECONDS=300

# Rate limiting for /auth/* endpoints (fixed window per client).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Distributed rate limiting: set REDIS_URL to share the counters across gateway
# instances (otherwise each process counts separately). Behind a proxy set
# TRUST_PROXY (e.g. 1 or "loopback") so the client IP comes from the forwarded
# headers and is used as the rate-limit key.
REDIS_URL=
TRUST_PROXY=

# Rate limiting for non-auth endpoints (more generous fixed window per client).
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=600

# Public probe (/ready) dependency-check cache in ms, to bound the DB round-trips
# an anonymous caller can trigger. /health and /ready also use the API limiter.
PROBE_CACHE_MS=1000

# Absolute path to the COBOL binary; defaults to ../../cobol/bin/main_logic
COBOL_BIN=

# Worker pool over the binary's serve mode (ADR-0010). 0 keeps file mode
# (one process per request). COBOL_POOL_PIPELINE is the in-flight cap per worker.
COBOL_POOL_SIZE=0
COBOL_POOL_TIMEOUT_MS=5000
COBOL_POOL_PIPELINE=1

# Metrics export: when set, the gateway periodically POSTs the Prometheus text
# from /metrics to this collector (e.g. a Pushgateway or OTLP-HTTP bridge).
METRICS_PUSH_URL=
METRICS_PUSH_INTERVAL_MS=15000

# Database connection for the COBOL binary, inherited from this process by the
# C bridge. Defaults match the development database; set these per deployment.
DB_HOST=localhost
DB_PORT=3306
DB_USER=cobol_user
DB_PASS=cobol_pass
DB_NAME=cobol_db

# Verification codes are delivered out of band, never in the HTTP response.
# Configure SMTP to email them; without SMTP they are only stored in
# verification_logs (read the DB in development). MAIL_DEBUG=1 additionally
# logs the code outside production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_TIMEOUT_MS=10000
MAIL_FROM=no-reply@cobol-banking.local
MAIL_FROM_NAME=
MAIL_DEBUG=
